{
  "Jwt": {
    "Issuer": "https://auth.kayas.dev",
    "Audience": "tenant-api",
    "Secret": "SET_VIA_USER_SECRETS"
  },
  "Modules": {
    "Store": {
      "Database": {
        "ConnectionString": "SET_VIA_USER_SECRETS"
      }
    },
    "Catalog": {
      "Database": {
        "ConnectionString": "SET_VIA_USER_SECRETS"
      }
    },
    "Customer": {
      "Database": {
        "ConnectionString": "SET_VIA_USER_SECRETS"
      }
    },
    "Pricing": {
      "Database": {
        "ConnectionString": "SET_VIA_USER_SECRETS"
      }
    },
    "Inventory": {
      "Database": {
        "ConnectionString": "SET_VIA_USER_SECRETS"
      }
    },
    "Notification": {
      "Database": {
        "ConnectionString": "SET_VIA_USER_SECRETS"
      },
      "Email": {
        "Provider": "Resend",
        "ApiKey": "SET_VIA_USER_SECRETS",
        "BaseUrl": "https://api.resend.com",
        "WebhookSecret": "SET_VIA_USER_SECRETS",
        "FromEmail": "notifications@kayas.dev",
        "FromName": "kayas Notifications",
        "ReplyTo": "support@kayas.dev"
      }
    },
    "Order": {
      "Database": {
        "ConnectionString": "SET_VIA_USER_SECRETS"
      }
    },
    "Payment": {
      "Database": {
        "ConnectionString": "SET_VIA_USER_SECRETS"
      },
      "Gateway": {
        "Provider": "Mock"
      },
      "Iyzico": {
        "BaseUrl": "https://sandbox-api.iyzipay.com",
        "ApiKey": "SET_VIA_USER_SECRETS",
        "SecretKey": "SET_VIA_USER_SECRETS",
        "Locale": "tr",
        "CallbackUrl": "https://your-public-host.example.com/api/payments/callbacks/iyzico/checkout-form",
        "DefaultBuyerIdentityNumber": "11111111111",
        "InitializeCheckoutFormPath": "/payment/iyzipos/checkoutform/initialize/auth/ecom",
        "RetrieveCheckoutFormPath": "/payment/iyzipos/checkoutform/auth/ecom/detail",
        "CapturePath": "/payment/capture",
        "CancelPath": "/payment/cancel",
        "RefundPath": "/payment/refund"
      }
    },
    "Shipment": {
      "Database": {
        "ConnectionString": "SET_VIA_USER_SECRETS"
      }
    }
  },
  "ServiceTokens": {
    "ECommerce": "SET_VIA_USER_SECRETS"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Store.API.ExceptionHandlers": "Debug",
      "API.Infrastructure.ExceptionHandlers": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "Microsoft.AspNetCore.DataProtection": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Environment": "Development"
    }
  }
}
